NODE_ENV=production
PORT=4000
APP_ORIGIN=https://your-restaurant.example
# Use a durable managed MongoDB replica set, with authentication, TLS and backups.
MONGODB_URI=
SUPER_ADMIN_EMAIL=
# Set a strong initial password through your host's secret manager; remove after provisioning.
BOOTSTRAP_PASSWORD=
# Explicit count of trusted reverse proxies. Leave unset if accessed directly.
TRUST_PROXY_HOPS=1
PAYMENTS_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
